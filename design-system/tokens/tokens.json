{
  "$description": "Abyss & Lantern — Meduza design tokens. Source of truth: edit here, then run `npm run tokens`. References use {path.to.token}.",

  "color": {
    "abyss": {
      "1000": "#05070E",
      "900": "#0B1020",
      "800": "#131A2E",
      "700": "#1E2742",
      "600": "#3A4566"
    },
    "mist": {
      "100": "#F5F5F7",
      "200": "#C9CCD6",
      "300": "#A7ABB8",
      "400": "#7C8294"
    },
    "pearl": {
      "50": "#FFFFFF",
      "100": "#F5F3EF",
      "200": "#EFE7D8",
      "300": "#E8DECB",
      "400": "#C9C2B4"
    },
    "ink": {
      "900": "#1D1D1F",
      "700": "#3A3A3F",
      "600": "#5E5E63",
      "500": "#6B675F"
    },
    "glow": {
      "300": "#B5E9F7",
      "400": "#7AD7F0",
      "700": "#0B6A88",
      "800": "#08546C"
    },
    "lantern": {
      "300": "#F7C994",
      "400": "#F0A860",
      "700": "#8A4E12",
      "800": "#6E3E0E"
    },
    "success": { "400": "#7FD49B", "700": "#1F7A45" },
    "danger": { "400": "#FF7A6B", "700": "#B3261E" }
  },

  "theme": {
    "abyss": {
      "bg": "{color.abyss.1000}",
      "surface": "{color.abyss.900}",
      "surface-raised": "{color.abyss.800}",
      "surface-pressed": "{color.abyss.700}",
      "text": "{color.mist.100}",
      "text-secondary": "{color.mist.300}",
      "text-tertiary": "{color.mist.400}",
      "text-on-media": "{color.mist.200}",
      "line": "rgba(255, 255, 255, 0.08)",
      "line-strong": "rgba(255, 255, 255, 0.16)",
      "fill-subtle": "rgba(255, 255, 255, 0.06)",
      "inverse": "{color.mist.100}",
      "inverse-text": "{color.abyss.1000}",
      "accent": "{color.glow.400}",
      "accent-hover": "{color.glow.300}",
      "accent-text": "{color.glow.400}",
      "on-accent": "{color.abyss.1000}",
      "accent-soft": "rgba(122, 215, 240, 0.12)",
      "accent-glow": "rgba(122, 215, 240, 0.35)",
      "secondary": "{color.lantern.400}",
      "secondary-text": "{color.lantern.400}",
      "secondary-soft": "rgba(240, 168, 96, 0.14)",
      "success": "{color.success.400}",
      "success-soft": "rgba(127, 212, 155, 0.12)",
      "danger": "{color.danger.400}",
      "danger-soft": "rgba(255, 122, 107, 0.12)",
      "disabled-bg": "{color.abyss.700}",
      "disabled-text": "{color.mist.400}",
      "glass-bg": "rgba(10, 15, 30, 0.55)",
      "glass-border": "rgba(255, 255, 255, 0.14)",
      "scrim": "linear-gradient(180deg, rgba(5, 7, 14, 0) 40%, rgba(5, 7, 14, 0.88) 100%)",
      "focus": "{color.glow.400}"
    },
    "pearl": {
      "bg": "{color.pearl.100}",
      "surface": "{color.pearl.50}",
      "surface-raised": "{color.pearl.200}",
      "surface-pressed": "{color.pearl.300}",
      "text": "{color.ink.900}",
      "text-secondary": "{color.ink.600}",
      "text-tertiary": "{color.ink.500}",
      "text-on-media": "{color.mist.200}",
      "line": "rgba(29, 29, 31, 0.10)",
      "line-strong": "{color.pearl.400}",
      "fill-subtle": "rgba(29, 29, 31, 0.05)",
      "inverse": "{color.ink.900}",
      "inverse-text": "{color.pearl.100}",
      "accent": "{color.glow.700}",
      "accent-hover": "{color.glow.800}",
      "accent-text": "{color.glow.700}",
      "on-accent": "#FFFFFF",
      "accent-soft": "rgba(11, 106, 136, 0.10)",
      "accent-glow": "rgba(11, 106, 136, 0.0)",
      "secondary": "{color.lantern.700}",
      "secondary-text": "{color.lantern.700}",
      "secondary-soft": "rgba(138, 78, 18, 0.10)",
      "success": "{color.success.700}",
      "success-soft": "rgba(31, 122, 69, 0.10)",
      "danger": "{color.danger.700}",
      "danger-soft": "rgba(179, 38, 30, 0.08)",
      "disabled-bg": "{color.pearl.300}",
      "disabled-text": "{color.ink.500}",
      "glass-bg": "rgba(245, 243, 239, 0.72)",
      "glass-border": "rgba(255, 255, 255, 0.5)",
      "scrim": "linear-gradient(180deg, rgba(5, 7, 14, 0) 40%, rgba(5, 7, 14, 0.80) 100%)",
      "focus": "{color.glow.700}"
    }
  },

  "mood": {
    "$description": "Moods swap the leading accent. Glow = lounge, bar, hookah (default). Lantern = dining, brunch.",
    "lantern": {
      "abyss": {
        "accent": "{color.lantern.400}",
        "accent-hover": "{color.lantern.300}",
        "accent-text": "{color.lantern.400}",
        "accent-soft": "rgba(240, 168, 96, 0.14)",
        "accent-glow": "rgba(240, 168, 96, 0.30)",
        "focus": "{color.lantern.400}"
      },
      "pearl": {
        "accent": "{color.lantern.700}",
        "accent-hover": "{color.lantern.800}",
        "accent-text": "{color.lantern.700}",
        "accent-soft": "rgba(138, 78, 18, 0.10)",
        "accent-glow": "rgba(138, 78, 18, 0.0)",
        "focus": "{color.lantern.700}"
      }
    }
  },

  "font": {
    "display": "'Inter Tight', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
    "text": "Inter, 'SF Pro Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
    "serif": "'Instrument Serif', 'New York', Georgia, 'Times New Roman', serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "google-fonts-url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&family=Instrument+Serif:ital@0;1&display=swap&subset=vietnamese,cyrillic"
  },

  "type": {
    "display":  { "size": "clamp(52px, 9vw, 128px)", "line": "0.98", "tracking": "-0.04em", "weight": "600" },
    "title-1":  { "size": "clamp(40px, 5vw, 64px)",  "line": "1.04", "tracking": "-0.035em", "weight": "600" },
    "title-2-m": { "size": "28px", "line": "1.1", "tracking": "-0.025em", "weight": "600" },
    "large-title": { "size": "34px", "line": "1.05", "tracking": "-0.03em", "weight": "600" },
    "title-2":  { "size": "clamp(30px, 3.4vw, 40px)", "line": "1.1",  "tracking": "-0.025em", "weight": "600" },
    "title-3":  { "size": "24px", "line": "1.25", "tracking": "-0.015em", "weight": "600" },
    "headline": { "size": "17px", "line": "1.47", "tracking": "0", "weight": "600" },
    "body":     { "size": "17px", "line": "1.47", "tracking": "0", "weight": "400" },
    "callout":  { "size": "15px", "line": "1.4",  "tracking": "0", "weight": "400" },
    "footnote": { "size": "13px", "line": "1.38", "tracking": "0", "weight": "400" },
    "caption":  { "size": "12px", "line": "1.33", "tracking": "0", "weight": "500" },
    "eyebrow":  { "size": "13px", "line": "1.2",  "tracking": "0.08em", "weight": "600" }
  },

  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
    "8": "32px", "10": "40px", "12": "48px", "16": "64px", "24": "96px", "32": "128px",
    "page-x": "clamp(20px, 6vw, 96px)",
    "section-y": "clamp(64px, 8vw, 96px)"
  },

  "radius": {
    "xs": "10px",
    "sm": "14px",
    "md": "18px",
    "lg": "22px",
    "xl": "28px",
    "2xl": "32px",
    "pill": "999px"
  },

  "size": {
    "control-sm": "44px",
    "control-md": "52px",
    "control-lg": "56px",
    "content-max": "1240px",
    "page-max": "1440px"
  },

  "shadow": {
    "e1": "0 8px 24px rgba(0, 0, 0, 0.45)",
    "e2": "0 24px 64px rgba(0, 0, 0, 0.6)",
    "glow": "0 0 40px var(--mz-accent-glow)",
    "segment": "0 2px 10px rgba(0, 0, 0, 0.35)"
  },

  "blur": {
    "glass": "blur(24px) saturate(180%)",
    "chip": "blur(16px)"
  },

  "motion": {
    "tide-duration": "240ms",
    "tide-ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "drift-duration": "700ms",
    "drift-ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "pulse-duration": "4s"
  },

  "breakpoint": {
    "phone": "760px",
    "tablet": "1024px"
  }
}
